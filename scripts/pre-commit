#!/bin/sh
# Optional pre-commit hook: lint staged Kotlin files with ktlint and detekt.
# Install (from the repo root): ln -s ../../scripts/pre-commit .git/hooks/pre-commit

if git diff --cached --name-only --diff-filter=ACM | grep -qE '\.kts?$'; then
    if ! ./gradlew :app:ktlintCheck :app:detekt --quiet; then
        echo "Lint failed. Hint: run ./gradlew :app:ktlintFormat to auto-fix formatting." >&2
        exit 1
    fi
fi
