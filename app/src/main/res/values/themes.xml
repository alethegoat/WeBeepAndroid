<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema base: lo sfondo della finestra coincide con quello di Compose per evitare lampi
         bianchi/neri tra splash e primo frame. Barre di sistema gestite da enableEdgeToEdge(). -->
    <style name="Theme.WeBeep" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/webeep_window_background</item>
    </style>

    <!-- Splash Screen API (androidx.core:core-splashscreen): attivo fino a installSplashScreen(),
         poi l'activity passa a Theme.WeBeep. -->
    <style name="Theme.WeBeep.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/webeep_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.WeBeep</item>
    </style>

</resources>
